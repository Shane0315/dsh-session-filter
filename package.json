{
  "name": "dsh-session-filter",
  "version": "0.1.0",
  "description": "Cross-workspace activity sidebar for DeepSeek Harness with live session status, search and local read tracking.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "src",
    "cordis.patch.yml",
    "README.md",
    "PRD.md",
    "LICENSE"
  ],
  "scripts": {
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:host && npm run build:client",
    "typecheck": "npm run typecheck:host && npm run typecheck:client",
    "typecheck:host": "tsc -p tsconfig.host.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shane0315/dsh-session-filter.git"
  },
  "homepage": "https://github.com/Shane0315/dsh-session-filter#readme",
  "bugs": {
    "url": "https://github.com/Shane0315/dsh-session-filter/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "activity",
    "sidebar"
  ]
}
